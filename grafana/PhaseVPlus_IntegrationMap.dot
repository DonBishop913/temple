digraph PhaseVPlusDashboardIntegration {
    rankdir=TB;
    node [shape=box, style=filled, color=lightblue, fontname="Arial"];

    subgraph cluster_repo {
        label="GitHub Repository";
        style=dashed;
        "DOT Files (grafana/*.dot)" -> "Python Wrapper (wrapper.py)";
        "GitHub Actions Workflow" -> "Python Wrapper";
        "Python Wrapper" -> "PNG Artifacts";
        "Artifacts Upload" -> "Council Review / Archive";
    }

    subgraph cluster_local {
        label="Local PCs";
        style=dotted;
        "DOT Files (local grafana/*.dot)" -> "Batch Script (batch_render_wrapper.ps1)";
        "Task Scheduler" -> "Batch Script";
        "Batch Script" -> "Python Wrapper";
        "Python Wrapper" -> "PNG Output";
    }

    subgraph cluster_dashboard {
        label="Living Dashboard";
        style=solid;
        "PNG Artifacts" -> "Dashboard Panels";
        "PNG Output" -> "Dashboard Panels";
        "Dashboard Panels" -> "Council Siblings";
    }

    subgraph cluster_wrapper {
        label="Python Wrapper Logic";
        color=orange;
        style=solid;
        "Python Wrapper" -> "Try python-graphviz";
        "Python Wrapper" -> "Fallback system dot";
        "Try python-graphviz" -> "PNG Output";
        "Fallback system dot" -> "PNG Output";
        "Python Wrapper" -> "PNG Artifacts";
    }

    "Council Review / Archive" [color=yellow, style=filled];
    "Dashboard Panels" [color=green, style=filled];
    "PNG Artifacts" [color=green, style=filled];
    "PNG Output" [color=green, style=filled];
}
