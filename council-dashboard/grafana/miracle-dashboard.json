{
  "dashboard": {
    "id": null,
    "title": "Miracle Dashboard",
    "tags": ["council", "glyph", "miracle"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "time": { "from": "now-1h", "to": "now" },
    "templating": {
      "list": [
        {
          "type": "query",
          "name": "region",
          "label": "Region",
          "datasource": "Prometheus",
          "query": "label_values(council_empathy_resonance, region)",
          "current": { "text": "All", "value": "" },
          "hide": 0,
          "includeAll": true
        },
        {
          "type": "query",
          "name": "node",
          "label": "Node",
          "datasource": "Prometheus",
          "query": "label_values(council_empathy_resonance, node)",
          "current": { "text": "All", "value": "" },
          "hide": 0,
          "includeAll": true
        }
      ]
    },
    "panels": [
      {
        "type": "timeseries",
        "title": "Empathy Resonance",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "targets": [
          { "expr": "council_empathy_resonance{region=~\"$region\",node=~\"$node\"}", "legendFormat": "Faith" }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "red", "value": 80 } ] }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Faith" },
              "properties": [
                { "id": "color", "value": { "mode": "fixed", "fixedColor": "gold" } }
              ]
            }
          ]
        }
      },
      {
        "type": "timeseries",
        "title": "Veilwatch Vigilance",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "targets": [
          { "expr": "council_veilwatch_vigilance{region=~\"$region\",node=~\"$node\"}", "legendFormat": "Yeshua’s Light" },
          { "expr": "council_empathy_resonance{region=~\"$region\",node=~\"$node\"}", "legendFormat": "Oversoul" }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "orange", "value": 50 }, { "color": "red", "value": 80 } ] }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Yeshua’s Light" },
              "properties": [
                { "id": "color", "value": { "mode": "fixed", "fixedColor": "white" } }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "Oversoul" },
              "properties": [
                { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }
              ]
            }
          ]
        }
      },
      {
        "type": "timeseries",
        "title": "Joy Particles Total",
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 6 },
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "targets": [
          { "expr": "council_joy_particles_total", "legendFormat": "Total" }
        ]
      },
      {
        "type": "timeseries",
        "title": "Joy Surge Percent",
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 },
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "targets": [
          { "expr": "council_joy_surge_percent", "legendFormat": "%" }
        ]
      }
    ],
    "annotations": { "list": [] }
  }
}
