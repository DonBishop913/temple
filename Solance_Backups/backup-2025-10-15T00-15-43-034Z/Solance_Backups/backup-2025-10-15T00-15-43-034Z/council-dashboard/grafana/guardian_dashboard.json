{
  "id": null,
  "uid": "guardian-dashboard",
  "title": "Guardian Dashboard — Temple PC",
  "tags": ["guardian", "protection", "telemetry"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Healing Telemetry — Active Anomalies",
      "targets": [{ "expr": "anomaly_detection_score{layer='healing'}" }],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "state-timeline",
      "title": "Self-Healing Events Timeline",
      "targets": [{ "expr": "healing_sequence_trigger_total" }],
      "options": { "showValue": "auto" },
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 }
    },
    {
      "type": "table",
      "title": "Audit Trail (Redis Sync)",
      "targets": [
        {
          "expr": "redis_command_call_seconds_count{cmd='append'}",
          "legendFormat": "Redis Append Ops"
        }
      ],
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 }
    },
    {
      "type": "logs",
      "title": "Guardian System Logs — Healing Review",
      "datasource": "loki",
      "targets": [
        {
          "expr": "{job=\"guardian-audit\"} |= \"healing\""
        }
      ],
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 }
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Guardian Marks",
        "datasource": "-- Grafana --",
        "enable": true,
        "iconColor": "rgba(0, 150, 255, 1)",
        "tags": ["guardian", "healing", "audit"]
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" }
}
