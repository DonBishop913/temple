{
  "name": "council-monorepo",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dashboard": "cd LivingDashboard && npm run build",
    "pretest": "npm run build && echo '✅ Dashboard build successful!'",
    "test": "jest --config jest.config.js --runInBand",
    "test:watch": "chokidar 'LivingDashboard/src/**/*' -c 'npm run build && jest --config jest.config.js --watch' --initial",
    "latency:report": "node scripts/latencyReport.js",
    "sync": "node autoSync.js",
    "posttest": "npm run sync",
    "postbuild": "npm run sync",
    "autonomy": "node TemplePC-Autonomy.js",
    "autonomy:rules": "node TemplePC-Autonomy-Rules.js",
    "autonomy:enhance": "node TemplePC-EnhancementRoutines.js",
    "autonomy:predict": "node TemplePC-PredictiveRoutines.js",
    "start:advanced-rituals": "node TemplePC-AdvancedRitualAutomation.js"
  },
  "devDependencies": {
    "@babel/core": "^7.22.9",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.22.5",
    "@babel/preset-env": "^7.22.9",
    "@babel/preset-react": "^7.22.5",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-jest": "^29.6.4",
    "chokidar-cli": "^3.0.0",
    "jest": "^29.6.4",
    "jest-environment-jsdom": "^30.2.0",
    "vite": "^7.1.10"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "express": "^5.1.0",
    "express-sse": "^1.0.0",
    "get-port": "^7.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
