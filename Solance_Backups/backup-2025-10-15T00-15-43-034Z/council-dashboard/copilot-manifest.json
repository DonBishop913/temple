{
  "phase": "YeshuaClock_Phase7",
  "modules": {
    "celestialTelemetry": {
      "source": [
        "SpaceX_API",
        "SSE_CouncilNodes",
        "SchumannSensor",
        "LunarPhaseAPI"
      ],
      "updateFrequency": 33,
      "destinations": [
        "PlanetOrbits",
        "SevenSistersOverlay",
        "Comet3IOverlay",
        "NodeLinkedOverlay"
      ]
    },
    "planetaryOrbits": {
      "planets": [
        "Mercury",
        "Venus",
        "Earth",
        "Mars",
        "Jupiter",
        "Saturn",
        "Uranus",
        "Neptune",
        "Pluto"
      ],
      "pulseMapping": "JoyParticles",
      "overlay": true
    },
    "cometTrajectory": {
      "name": "3I_ATLAS",
      "source": "SpaceX_API",
      "pulseMapping": "OverridePulse",
      "trailEffect": "particleStream"
    },
    "sevenSistersOverlay": {
      "source": "SSE_CouncilNodes",
      "lunarCycleSync": true,
      "pulseMapping": "JoyParticles"
    },
    "spectralTrail": {
      "link": ["nodes", "planets", "ritualGlyphs"],
      "effect": "energyWave",
      "syncWith": "OversoulHeartbeat"
    },
    "oversoulEngine": {
      "audioVisual": true,
      "baseFrequencyHz": 7.83,
      "harmonicBlendHz": 432,
      "nodeSync": true,
      "ritualPulseSync": true
    },
    "operatorPanel": {
      "route": "/admin/oversoul-panel",
      "auth": "token+role",
      "controls": [
        "ritualIntensity",
        "energyFlux",
        "telemetryCalibration",
        "joyParticleTuning"
      ],
      "autoRefresh": 1980
    }
  },
  "orchestrationRules": {
    "heartbeatInterval": 33,
    "updateSequence": [
      "celestialTelemetry",
      "planetaryOrbits",
      "cometTrajectory",
      "sevenSistersOverlay",
      "spectralTrail",
      "oversoulEngine"
    ],
    "pulseScaling": {
      "JoyParticles": 0.001,
      "OverridePulse": 0.01
    },
    "telemetryFallback": {
      "defaultPlanets": true,
      "defaultNodeValues": true
    }
  },
  "deployment": {
    "scripts": {
      "start": "npm run dev:all",
      "breathCycle": "npm run breath"
    },
    "backends": ["NodeAPI", "WebSocketServer", "RedisPersistence"],
    "security": ["TLS", "EnvSecrets", "RoleBasedAuth"]
  },
  "documentation": {
    "modulesDoc": "docs/modules.md",
    "integrationGuide": "docs/integration.md",
    "telemetryMap": "docs/telemetry.json"
  }
}
