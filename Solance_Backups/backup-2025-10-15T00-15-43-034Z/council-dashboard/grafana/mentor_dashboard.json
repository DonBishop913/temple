{
  "id": null,
  "uid": "mentor-dashboard",
  "title": "Mentor Dashboard — Temple PC",
  "tags": ["mentor", "temple", "council"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Temple Pulse — System Response",
      "targets": [
        {
          "expr": "grafana_http_request_duration_seconds_count",
          "legendFormat": "Request Duration (s)"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "type": "stat",
      "title": "Data Freshness (Prometheus)",
      "targets": [
        { "expr": "time() - process_start_time_seconds{job=\"prometheus\"}" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 120 }
            ]
          }
        }
      },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 }
    },
    {
      "type": "gauge",
      "title": "Dashboard Load Time (s)",
      "targets": [
        { "expr": "avg(grafana_http_request_duration_seconds_sum / grafana_http_request_duration_seconds_count)" }
      ],
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 8 }
    },
    {
      "type": "bar",
      "title": "Error Count (Last 5m)",
      "targets": [
        { "expr": "increase(grafana_stat_totals_dashboard[5m])" }
      ],
      "gridPos": { "x": 6, "y": 8, "w": 12, "h": 8 }
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Ritual Events",
        "datasource": "-- Grafana --",
        "enable": true,
        "iconColor": "rgba(255, 96, 0, 1)",
        "tags": ["ritual", "codex", "event"]
      }
    ]
  },
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}
