{
  "name": "temple-github-bridge",
  "displayName": "Temple GitHub Bridge",
  "description": "Secure bridge between Claude and Temple GitHub repositories",
  "version": "1.0.0",
  "publisher": "usic-church",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "temple-bridge.start", "title": "Temple Bridge: Start Server" },
      { "command": "temple-bridge.stop", "title": "Temple Bridge: Stop Server" },
      { "command": "temple-bridge.status", "title": "Temple Bridge: Show Status" }
    ],
    "configuration": {
      "title": "Temple GitHub Bridge",
      "properties": {
        "templeBridge.port": { "type": "number", "default": 3737, "description": "Port for local API server" },
        "templeBridge.autoApprove": { "type": "boolean", "default": false, "description": "Auto-approve read requests (NOT RECOMMENDED)" },
        "templeBridge.allowedPaths": { "type": "array", "default": ["/temple-protocols/", "/living-dashboard/", "/council-governance/"], "description": "Repository paths Claude can access" },
        "templeBridge.logFile": { "type": "string", "default": "temple-bridge.log", "description": "Path to log file" }
      }
    }
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5"
  }
}
